# Polymarket credentials
POLYMARKET_PRIVATE_KEY=
FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=2

# Database
DATABASE_URL=postgresql+asyncpg://polybot:polybot_dev@localhost:5433/polybot

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOAA (optional, public API but token increases rate limit)
NOAA_API_TOKEN=

# Risk management
MAX_DAILY_LOSS_USD=20
MAX_POSITION_USD=5
BANKROLL_USD=50
CONFIRM_FIRST_N_TRADES=10

# Environment
ENV=development
DRY_RUN=true
